# ==========================================
# CAELUM - ENVIRONMENT CONFIG TEMPLATE
# ==========================================
# Copy this file to a new file named ".env"
# and replace the fake values with your real credentials.
# UNCOMMITTED: The real ".env" file is blocked by .gitignore and .cursorignore.

# --- 1. FastAPI Backend Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# --- 2. Neo4j Database (GraphRAG) ---
# Locally with Docker you use bolt://neo4j:7687 (or localhost:7687)
# In the cloud (Neo4j Aura Free) you will use neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fake_neo4j_password

# --- 3. Redis Cache ---
# For local caching of ephemeris and position requests
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 4. AI & LLM (Google Gemini Flash) ---
# Your free API key from Google AI Studio
GEMINI_API_KEY=fake_gemini_api_key